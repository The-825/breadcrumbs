#!/usr/bin/env python3
"""mem: the one door to a repo's settled facts.

Usage:
  mem                        print the cheat card
  mem <words>                look up a fact (exact key or alias first, then ranked)
  mem --stdin                read the query from stdin; print hits or nothing
  mem add "<text>" [flags]   append raw capture to the journal
      --type fact|decision|gotcha|todo|state   (default: fact)
      --key <index key>      the key you looked up and missed
      --source <path|PR|D-n> where the fact lives or was proven
  mem reject "<key>" --reason "<why>"
                             retire a wrong answer and tombstone it, so the
                             same value cannot come back silently
  mem recheck                list rows whose SOURCE changed after the row was
                             last checked; evidence-based drift, not a calendar
  mem check                  integrity gate; non-zero exit on any defect

Design contract (the docs cite these constants; change them here and nowhere
else): the kernel stays at or under KERNEL_MAX_LINES lines, a query prints at
most MAX_HITS rows, and --stdin (hook mode) stays silent unless a hit scores
MIN_HOOK_SCORE or better, so prompt injection never rides a weak match. The
staleness horizon is adaptive (see adaptive_stale_days()): it reads from the
ledger's own re-check cadence rather than one fixed number for every repo,
STALE_DAYS is only the fallback for a ledger too new or too small to have a
cadence yet, clamped between STALE_FLOOR and STALE_CEILING either way.

Correction, and what it does and does not do. `reject` is the must-not-come-back
test: the retired answer is recorded in tombstones.tsv and `check` fails if that
same key comes back carrying that same answer. A key returning with a DIFFERENT
answer is a correction and passes, which is the point. `recheck` compares each
row's source against its checked date and reports the ones whose ground moved.
It detects that the source changed, NOT that the fact became false; a human
still decides. Neither command re-verifies a fact automatically, because nothing
mechanical can read a source and know whether the claim still holds.

Reserved first words: `add`, `check`, `reject` and `recheck` are subcommands, so
index keys must not begin with any of them. `mem check` enforces that.

Exit codes: 0 hit or success, 1 miss, 2 usage error or integrity failure.
Stdlib only, python3.8+. Paths resolve relative to this file, so the desk works
wherever the directory is copied.
"""

import json
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

KERNEL_MAX_LINES = 60
MAX_HITS = 3
STALE_DAYS = 30      # fallback when the ledger has too few checked dates to adapt from
STALE_FLOOR = 14     # never call a row stale sooner than this, no matter how fast the ledger moves
STALE_CEILING = 90   # never let a quiet ledger's rows go longer than this unquestioned
STALE_SAMPLE_MIN = 3  # need at least this many dated rows before trusting the adaptive figure
MIN_HOOK_SCORE = 3   # one key/alias token of overlap; answer-only matches stay out of hooks
STDIN_CAP = 400      # chars of stdin considered in hook mode; prompts are long, keys are not

BASE = Path(__file__).resolve().parent
INDEX = BASE / "index.tsv"
JOURNAL = BASE / "journal.jsonl"
TOMBSTONES = BASE / "tombstones.tsv"  # retired answers; 4 cols: key, value, reason, date
# In-template the kernel keeps its template name; adoption renames it to MEMORY.md.
KERNEL = next(
    (p for p in (BASE / "MEMORY.md", BASE / "MEMORY_TEMPLATE.md") if p.exists()),
    BASE / "MEMORY.md",
)

TYPES = {"fact", "decision", "gotcha", "todo", "state"}
SUBCOMMANDS = ("add", "check", "reject", "recheck")
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
STOPWORDS = {
    "a", "an", "and", "are", "can", "do", "does", "for", "how", "i", "in",
    "is", "it", "my", "of", "on", "or", "our", "the", "this", "to", "we",
    "what", "when", "where", "which", "who", "why", "you", "your",
}

CARD = f"""the memory desk · one door to this repo's settled facts
  look up   memory/mem <words>          exact key or alias first, ranked fallback
  capture   memory/mem add "<fact>" --type fact|decision|gotcha [--key k] [--source p]
  correct   memory/mem reject "<key>" --reason "<why>"   retire a wrong answer
  drift     memory/mem recheck          rows whose source moved since last check
  health    memory/mem check            duplicate keys, dead sources, oversized kernel
  stores    {KERNEL.name} (kernel, read at boot) · index.tsv (facts) · journal.jsonl (raw)
  no shell  grep -i '<word>' memory/index.tsv reads the same rows
a miss prints your next command; run it rather than answering from recall."""


def tokens(s):
    return [t for t in re.findall(r"[a-z0-9]+", s.lower()) if t not in STOPWORDS]


def norm(s):
    return " ".join(re.findall(r"[a-z0-9]+", s.lower()))


def repo_root():
    p = BASE
    while p != p.parent:
        if (p / ".git").exists():
            return p
        p = p.parent
    return None


def load_rows():
    """Parse index.tsv. Returns (rows, defects); a defective line is skipped
    here and reported by check(), so a typo never breaks every lookup."""
    rows, defects = [], []
    if not INDEX.exists():
        return rows, [f"index missing: {INDEX.name}"]
    for n, line in enumerate(INDEX.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) != 5:
            defects.append(
                f"line {n}: {len(parts)} fields, want 5 (key, aliases, answer, source, checked)"
            )
            continue
        key, aliases, answer, source, checked = (p.strip() for p in parts)
        rows.append({
            "line": n,
            "key": key,
            "answer": answer,
            "source": source,
            "checked": checked,
            "aliases": [a.strip() for a in aliases.split("|") if a.strip()],
        })
    return rows, defects


def adaptive_stale_days(rows):
    """The ledger sets its own staleness horizon instead of one fixed number
    for every repo. A ledger that gets re-checked every couple of weeks
    should flag drift fast; a quiet one re-checked every few months would
    have every row permanently flagged at a 30-day fixed threshold, which
    trains people to ignore the flag. Median gap between consecutive
    `checked` dates, times 3 (three check-cycles of grace before calling it
    stale), clamped to [STALE_FLOOR, STALE_CEILING]. Falls back to
    STALE_DAYS when there are too few dated rows to trust a median from
    (STALE_SAMPLE_MIN), the same way a small sample shouldn't drive a
    confident statistic anywhere else in this repo.
    """
    dates = []
    for r in rows:
        c = r.get("checked", "")
        if DATE_RE.match(c):
            try:
                dates.append(datetime.strptime(c, "%Y-%m-%d").replace(tzinfo=timezone.utc))
            except ValueError:
                continue
    if len(dates) < STALE_SAMPLE_MIN:
        return STALE_DAYS
    dates.sort()
    gaps = [(b - a).days for a, b in zip(dates, dates[1:])]
    gaps = [g for g in gaps if g > 0]
    if not gaps:
        return STALE_DAYS
    gaps.sort()
    mid = len(gaps) // 2
    median_gap = gaps[mid] if len(gaps) % 2 else (gaps[mid - 1] + gaps[mid]) / 2
    return max(STALE_FLOOR, min(STALE_CEILING, round(median_gap * 3)))


def age_note(checked, stale_days=STALE_DAYS):
    if checked in ("", "-"):
        return "unchecked"
    if not DATE_RE.match(checked):
        return f"checked {checked}"
    try:
        d = datetime.strptime(checked, "%Y-%m-%d").replace(tzinfo=timezone.utc)
    except ValueError:
        return f"checked {checked}"
    if (datetime.now(timezone.utc) - d).days > stale_days:
        return f"checked {checked} · STALE, re-verify at the source ({stale_days}d horizon)"
    return f"checked {checked} ({stale_days}d horizon)"


def show(row, stale_days=STALE_DAYS):
    print(f"{row['key']}  ({age_note(row['checked'], stale_days)})")
    print(f"  {row['answer']}")
    print(f"  source: {row['source']}")


def score(row, q, qtoks):
    rtoks = set(tokens(row["key"]))
    for a in row["aliases"]:
        rtoks.update(tokens(a))
    s = 3 * len(qtoks & rtoks) + len(qtoks & set(tokens(row["answer"])))
    if q and (q in norm(row["key"]) or any(q in norm(a) for a in row["aliases"])):
        s += 2
    return s


def lookup(words, hook_mode=False):
    rows, _ = load_rows()
    stale_days = adaptive_stale_days(rows)
    q = norm(" ".join(words))
    qtoks = set(tokens(" ".join(words)))
    if not q and not qtoks:
        return 1
    exact = [r for r in rows if norm(r["key"]) == q or q in [norm(a) for a in r["aliases"]]]
    if exact:
        show(exact[0], stale_days)
        return 0
    # No live row owns this key. Before falling back to fuzzy neighbours, check
    # whether the desk already retired it: a known-wrong answer beats a ranked
    # guess, and without this the ladder sends someone off to re-derive the
    # exact value the tombstone exists to stop coming back. Exact key match
    # only, so a retirement never preempts an unrelated query that merely
    # shares a word.
    if not hook_mode:
        tombs, _ = load_tombstones()
        retired = [t for t in tombs if norm(t["key"]) == q]
        if retired:
            for t in retired[:MAX_HITS]:
                print(f"{t['key']}: RETIRED {t['date']}")
                print(f"  was: {t['value']}")
                print(f"  why: {t['reason']}")
            print("\nno live row replaced it. find the current answer and 'mem add' it.")
            return 1
    ranked = sorted(((score(r, q, qtoks), r) for r in rows), key=lambda t: (-t[0], t[1]["key"]))
    floor = MIN_HOOK_SCORE if hook_mode else 1
    hits = [r for s, r in ranked if s >= floor][:MAX_HITS]
    if hits:
        for i, r in enumerate(hits):
            if i:
                print()
            show(r, stale_days)
        return 0
    if not hook_mode:
        seed = sorted(qtoks)[0] if qtoks else words[0]
        asked = " ".join(words)
        print(f"mem: no index hit for '{asked}'")
        print("do these in order; never answer from recall:")
        print(f"  1. grep -ril '{seed}' . | head -5      (from the repo root)")
        print("  2. read the narrow range the grep finds")
        print(f'  3. memory/mem add "<the answer>" --key \'{asked}\' --source <path>')
    return 1


def add(argv):
    text, typ, key, source = None, "fact", None, None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--type":
            i += 1
            typ = argv[i] if i < len(argv) else ""
        elif a == "--key":
            i += 1
            key = argv[i] if i < len(argv) else ""
        elif a == "--source":
            i += 1
            source = argv[i] if i < len(argv) else ""
        elif text is None:
            text = a
        else:
            text += " " + a
        i += 1
    if not text or not text.strip():
        print("mem add: nothing to journal; pass the fact as one quoted sentence", file=sys.stderr)
        return 2
    if typ not in TYPES:
        print(f"mem add: --type must be one of {'|'.join(sorted(TYPES))}", file=sys.stderr)
        return 2
    entry = {
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "type": typ,
        "text": text.strip(),
    }
    if key:
        entry["key"] = key
    if source:
        entry["source"] = source
    with JOURNAL.open("a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    print(f"journaled ({typ}). the gardener promotes durable entries to index.tsv on its next pass.")
    return 0


def load_tombstones():
    """Parse tombstones.tsv. Returns (entries, defects). A retired answer lives
    here forever; the file is append-only by convention and diffable on purpose,
    so the record of what was wrong survives being right about it later."""
    out, defects = [], []
    if not TOMBSTONES.exists():
        return out, defects
    for n, line in enumerate(TOMBSTONES.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) != 4:
            defects.append(f"line {n}: {len(parts)} fields, want 4 (key, value, reason, date)")
            continue
        key, value, reason, date = (x.strip() for x in parts)
        out.append({"line": n, "key": key, "value": value, "reason": reason, "date": date})
    return out, defects


def source_changed_on(src):
    """Last date the source actually moved, as YYYY-MM-DD, or None.

    Prefers the file's last git commit date over its mtime, because mtime is
    checkout time on a fresh clone and would flag every row in the ledger the
    first time someone ran this on a new machine. Falls back to mtime only when
    git cannot answer, and returns None when neither can.
    """
    root = repo_root()
    for base in [BASE] + ([root] if root else []):
        f = base / src
        if not f.exists():
            continue
        try:
            r = subprocess.run(
                ["git", "-C", str(f.parent), "log", "-1", "--format=%cs", "--", f.name],
                capture_output=True, text=True, timeout=10,
            )
            out = r.stdout.strip()
            if r.returncode == 0 and DATE_RE.match(out):
                return out
        except (OSError, subprocess.SubprocessError):
            pass
        try:
            return datetime.fromtimestamp(f.stat().st_mtime, timezone.utc).strftime("%Y-%m-%d")
        except OSError:
            return None
    return None


def looks_like_path(src):
    return bool(src) and "://" not in src and " " not in src and not src.startswith(("PR", "D-", "#"))


def reject(argv):
    """Retire a wrong answer and tombstone it.

    Removes the row from index.tsv, records key, the rejected answer, the reason
    and the date in tombstones.tsv, and journals the correction so the raw trail
    keeps it too. The value of the tombstone is not the deletion, which a text
    editor could do; it is that check() now fails if that key comes back with
    that same answer.
    """
    key, reason = None, None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--reason":
            i += 1
            reason = argv[i] if i < len(argv) else ""
        elif key is None:
            key = a
        else:
            key += " " + a
        i += 1
    if not key or not key.strip():
        print('mem reject: name the key, quoted', file=sys.stderr)
        return 2
    if not reason or not reason.strip():
        print("mem reject: --reason is required; a tombstone with no reason is a deletion",
              file=sys.stderr)
        return 2

    rows, _ = load_rows()
    target = None
    for r in rows:
        if norm(r["key"]) == norm(key) or norm(key) in [norm(a) for a in r["aliases"]]:
            target = r
            break
    if not target:
        print(f"mem reject: no row for '{key}'; nothing to retire")
        return 1

    lines = INDEX.read_text(encoding="utf-8").splitlines()
    kept = [ln for n, ln in enumerate(lines, 1) if n != target["line"]]
    INDEX.write_text("\n".join(kept) + ("\n" if kept else ""), encoding="utf-8")

    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    new_file = not TOMBSTONES.exists()
    with TOMBSTONES.open("a", encoding="utf-8") as f:
        if new_file:
            f.write("# key\tvalue\treason\tdate  (retired answers; append only)\n")
        f.write("\t".join([target["key"], target["answer"], reason.strip(), today]) + "\n")

    with JOURNAL.open("a", encoding="utf-8") as f:
        f.write(json.dumps({
            "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "type": "decision",
            "text": f"rejected '{target['key']}': {reason.strip()}",
            "key": target["key"],
        }, ensure_ascii=False) + "\n")

    print(f"retired '{target['key']}' and tombstoned its answer.")
    print("check() will now fail if that key returns carrying the same answer.")
    print("a different answer for the same key is a correction and passes.")
    return 0


def recheck():
    """Rows whose source moved after the row was last checked.

    This is drift by evidence rather than by calendar: the adaptive staleness
    horizon asks how long it has been, this asks whether the ground actually
    shifted. It reports suspicion, never a verdict. A changed source does not
    make a fact false, and an unchanged source does not make it true.
    """
    rows, defects = load_rows()
    if defects:
        print("index.tsv has defects; run 'mem check' first")
        return 2
    drifted, unknown = [], []
    for r in rows:
        if not looks_like_path(r["source"]):
            continue
        moved = source_changed_on(r["source"])
        if moved is None:
            unknown.append(r)
        elif r["checked"] != "-" and DATE_RE.match(r["checked"]) and moved > r["checked"]:
            drifted.append((r, moved))
    if drifted:
        print(f"{len(drifted)} row(s) whose source moved after the last check:\n")
        for r, moved in sorted(drifted, key=lambda x: x[1], reverse=True):
            print(f"  {r['key']}")
            print(f"    checked {r['checked']}, source {r['source']} changed {moved}")
        print("\nre-read the source and either re-date the row or 'mem reject' it.")
    else:
        print("no source has moved since its row was checked.")
    if unknown:
        print(f"\n{len(unknown)} row(s) whose source date could not be read "
              f"(not tracked by git and no readable mtime); check those by hand.")
    return 0


def check():
    problems = []
    rows, defects = load_rows()
    problems += [f"index.tsv {d}" for d in defects]
    seen = {}
    root = repo_root()
    for r in rows:
        k = norm(r["key"])
        if not k:
            problems.append(f"index.tsv line {r['line']}: empty key")
        if k.split(" ")[0] in SUBCOMMANDS:
            problems.append(
                f"index.tsv line {r['line']}: key starts with a reserved subcommand word "
                f"({'/'.join(SUBCOMMANDS)})"
            )
        if not r["answer"]:
            problems.append(f"index.tsv line {r['line']}: empty answer")
        if not r["source"]:
            problems.append(f"index.tsv line {r['line']}: empty source")
        if not (r["checked"] == "-" or DATE_RE.match(r["checked"])):
            problems.append(f"index.tsv line {r['line']}: checked must be YYYY-MM-DD or '-'")
        for name in [k] + [norm(a) for a in r["aliases"]]:
            if not name:
                continue
            if name in seen and seen[name] != r["line"]:
                problems.append(
                    f"index.tsv line {r['line']}: '{name}' collides with line {seen[name]}; one key or alias, one row"
                )
            else:
                seen.setdefault(name, r["line"])
        src = r["source"]
        if looks_like_path(src):
            candidates = [BASE / src] + ([root / src] if root else [])
            if not any(c.exists() for c in candidates):
                problems.append(
                    f"index.tsv line {r['line']}: source '{src}' resolves nowhere (tried the desk dir and the repo root)"
                )
    tombs, tdefects = load_tombstones()
    problems += [f"tombstones.tsv {d}" for d in tdefects]
    retired = {(norm(t["key"]), norm(t["value"])): t for t in tombs}
    for r in rows:
        hit = retired.get((norm(r["key"]), norm(r["answer"])))
        if hit:
            problems.append(
                f"index.tsv line {r['line']}: '{r['key']}' is back carrying the answer retired "
                f"on {hit['date']} ({hit['reason']}); a different answer would be a correction, "
                f"this one is the same value returning"
            )
    if not KERNEL.exists():
        problems.append(f"kernel missing: {KERNEL.name}")
    else:
        n = len(KERNEL.read_text(encoding="utf-8").splitlines())
        if n > KERNEL_MAX_LINES:
            problems.append(
                f"{KERNEL.name}: {n} lines, cap is {KERNEL_MAX_LINES}; move content into index rows"
            )
    if JOURNAL.exists():
        for n, line in enumerate(JOURNAL.read_text(encoding="utf-8").splitlines(), 1):
            if not line.strip():
                continue
            try:
                e = json.loads(line)
                ok = isinstance(e, dict) and e.get("ts") and e.get("type") in TYPES and e.get("text")
            except ValueError:
                ok = False
            if not ok:
                problems.append(f"journal.jsonl line {n}: not a valid entry (need ts, type, text)")
    if problems:
        for p in problems:
            print(p)
        print(f"mem check: {len(problems)} problem(s)")
        return 2
    kn = len(KERNEL.read_text(encoding="utf-8").splitlines())
    print(f"memory ok: {len(rows)} rows, kernel {kn}/{KERNEL_MAX_LINES} lines")
    return 0


def main(argv):
    if not argv:
        print(CARD)
        return 0
    if argv[0] == "add":
        return add(argv[1:])
    if argv[0] == "check":
        return check()
    if argv[0] == "reject":
        return reject(argv[1:])
    if argv[0] == "recheck":
        return recheck()
    if argv[0] == "--stdin":
        raw = sys.stdin.read()[:STDIN_CAP]
        return lookup(raw.split(), hook_mode=True)
    if argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    return lookup(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
