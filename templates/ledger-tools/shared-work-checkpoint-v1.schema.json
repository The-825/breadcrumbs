{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-825.github.io/breadcrumbs/contracts/shared-work-checkpoint-v1.schema.json",
  "title": "Portable shared work checkpoint v1",
  "description": "Bounded control evidence for an adopter-owned append-only ledger.",
  "oneOf": [
    {"$ref": "#/$defs/checkpoint"},
    {"$ref": "#/$defs/load_receipt"},
    {"$ref": "#/$defs/release"}
  ],
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n]+$"
    },
    "bounded_text_list": {
      "type": "array",
      "maxItems": 24,
      "items": {"$ref": "#/$defs/bounded_text"}
    },
    "scope": {
      "type": "object",
      "required": ["work_id", "project_id", "repository", "worktree"],
      "properties": {
        "work_id": {"$ref": "#/$defs/opaque_id"},
        "project_id": {"$ref": "#/$defs/opaque_id"},
        "repository": {"$ref": "#/$defs/opaque_id"},
        "worktree": {"$ref": "#/$defs/opaque_id"}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["level", "source", "evidence_ref"],
      "properties": {
        "level": {"$ref": "#/$defs/bounded_text"},
        "source": {"$ref": "#/$defs/bounded_text"},
        "evidence_ref": {"$ref": "#/$defs/bounded_text"}
      },
      "additionalProperties": false
    },
    "model_evidence_item": {
      "type": "object",
      "required": ["state", "model", "source"],
      "properties": {
        "state": {"enum": ["verified", "unknown", "unavailable"]},
        "model": {"type": ["string", "null"], "maxLength": 160},
        "source": {"type": ["string", "null"], "maxLength": 512}
      },
      "additionalProperties": false
    },
    "model_evidence": {
      "type": "object",
      "required": ["requested", "configured", "observed"],
      "properties": {
        "requested": {"$ref": "#/$defs/model_evidence_item"},
        "configured": {"$ref": "#/$defs/model_evidence_item"},
        "observed": {"$ref": "#/$defs/model_evidence_item"}
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": ["principal", "role", "evidence"],
      "properties": {
        "principal": {"enum": ["jovan", "claude", "codex"]},
        "role": {"enum": ["owner", "planner", "reviewer", "worker", "subagent"]},
        "evidence": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/model_evidence"}
          ]
        }
      },
      "additionalProperties": false
    },
    "stage_contract": {
      "type": "object",
      "required": ["policy_id", "stage", "members"],
      "properties": {
        "policy_id": {"const": "shared-work-stage-policy-v1"},
        "stage": {"enum": ["planning", "implementation"]},
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/member"}
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "required": ["policy_id", "planning", "implementation"],
      "properties": {
        "policy_id": {"const": "shared-work-stage-policy-v1"},
        "planning": {"$ref": "#/$defs/stage_contract"},
        "implementation": {"$ref": "#/$defs/stage_contract"}
      },
      "additionalProperties": false
    },
    "alternative": {
      "type": "object",
      "required": ["approach", "tradeoffs", "reuse_or_no_change"],
      "properties": {
        "approach": {"$ref": "#/$defs/bounded_text"},
        "tradeoffs": {"$ref": "#/$defs/bounded_text"},
        "reuse_or_no_change": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "unresolved_issue": {
      "type": "object",
      "required": ["issue", "resolution"],
      "properties": {
        "issue": {"$ref": "#/$defs/bounded_text"},
        "resolution": {"$ref": "#/$defs/bounded_text"}
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": [
        "objective",
        "deliverables",
        "scope",
        "constraints",
        "completion_evidence",
        "milestones",
        "alternatives",
        "selected_approach",
        "adversarial",
        "unresolved_issues"
      ],
      "properties": {
        "objective": {"$ref": "#/$defs/bounded_text"},
        "deliverables": {"$ref": "#/$defs/nonempty_bounded_text_list"},
        "scope": {
          "type": "object",
          "required": ["included", "exclusions", "affected_repositories", "dependencies"],
          "properties": {
            "included": {"$ref": "#/$defs/nonempty_bounded_text_list"},
            "exclusions": {"$ref": "#/$defs/nonempty_bounded_text_list"},
            "affected_repositories": {"$ref": "#/$defs/nonempty_bounded_text_list"},
            "dependencies": {"$ref": "#/$defs/nonempty_bounded_text_list"}
          },
          "additionalProperties": false
        },
        "constraints": {"$ref": "#/$defs/nonempty_bounded_text_list"},
        "completion_evidence": {"$ref": "#/$defs/nonempty_bounded_text_list"},
        "milestones": {"$ref": "#/$defs/nonempty_bounded_text_list"},
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "contains": {
            "type": "object",
            "properties": {"reuse_or_no_change": {"const": true}},
            "required": ["reuse_or_no_change"]
          },
          "items": {"$ref": "#/$defs/alternative"}
        },
        "selected_approach": {"$ref": "#/$defs/bounded_text"},
        "adversarial": {
          "type": "object",
          "required": [
            "failure_modes",
            "contradictory_evidence",
            "edge_cases",
            "privacy_authority",
            "recovery",
            "disproof_tests"
          ],
          "properties": {
            "failure_modes": {"$ref": "#/$defs/nonempty_bounded_text_list"},
            "contradictory_evidence": {"$ref": "#/$defs/nonempty_bounded_text_list"},
            "edge_cases": {"$ref": "#/$defs/nonempty_bounded_text_list"},
            "privacy_authority": {"$ref": "#/$defs/nonempty_bounded_text_list"},
            "recovery": {"$ref": "#/$defs/nonempty_bounded_text_list"},
            "disproof_tests": {"$ref": "#/$defs/nonempty_bounded_text_list"}
          },
          "additionalProperties": false
        },
        "unresolved_issues": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/$defs/unresolved_issue"}
        }
      },
      "additionalProperties": false
    },
    "nonempty_bounded_text_list": {
      "allOf": [
        {"$ref": "#/$defs/bounded_text_list"},
        {"minItems": 1}
      ]
    },
    "freshness": {
      "type": "object",
      "required": ["state", "source_revision", "invalidated_by"],
      "properties": {
        "state": {"enum": ["current", "stale", "unknown"]},
        "source_revision": {"type": ["string", "null"], "maxLength": 512},
        "invalidated_by": {"$ref": "#/$defs/bounded_text_list"}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["measurement", "input_tokens", "output_tokens", "cost_usd"],
      "properties": {
        "measurement": {"enum": ["measured", "estimated", "unknown"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "attempted_action", "observation", "known_cause", "suspected_cause",
        "side_effects", "blocker"
      ],
      "properties": {
        "attempted_action": {"$ref": "#/$defs/bounded_text"},
        "observation": {"$ref": "#/$defs/bounded_text"},
        "known_cause": {"$ref": "#/$defs/bounded_text"},
        "suspected_cause": {"$ref": "#/$defs/bounded_text"},
        "side_effects": {"$ref": "#/$defs/bounded_text"},
        "blocker": {"$ref": "#/$defs/bounded_text"}
      },
      "additionalProperties": false
    },
    "workaround": {
      "type": "object",
      "required": ["rationale", "checks", "residual_limits"],
      "properties": {
        "rationale": {"$ref": "#/$defs/bounded_text"},
        "checks": {"$ref": "#/$defs/nonempty_bounded_text_list"},
        "residual_limits": {"$ref": "#/$defs/nonempty_bounded_text_list"}
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "schema_version", "record_type", "operation_id", "event_id", "scope",
        "kind", "task_state", "source", "provenance", "evidence", "remaining",
        "next_action", "freshness", "usage", "occurred_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "record_type": {"const": "checkpoint"},
        "operation_id": {"$ref": "#/$defs/opaque_id"},
        "event_id": {"$ref": "#/$defs/opaque_id"},
        "scope": {"$ref": "#/$defs/scope"},
        "kind": {"enum": ["plan", "decision", "correction", "material_progress", "milestone", "blocker", "failure", "workaround", "recovery", "completion"]},
        "task_state": {"enum": ["in_progress", "completed"]},
        "source": {"$ref": "#/$defs/bounded_text"},
        "provenance": {"$ref": "#/$defs/nonempty_bounded_text_list"},
        "evidence": {"$ref": "#/$defs/bounded_text_list"},
        "remaining": {"$ref": "#/$defs/bounded_text_list"},
        "next_action": {"type": "string", "maxLength": 512, "pattern": "^[^\\r\\n]*$"},
        "freshness": {"$ref": "#/$defs/freshness"},
        "usage": {"$ref": "#/$defs/usage"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "authority": {"$ref": "#/$defs/authority"},
        "contracts": {"$ref": "#/$defs/contracts"},
        "plan": {"$ref": "#/$defs/plan"},
        "plan_revision": {"type": "integer", "minimum": 1},
        "supersedes_event_id": {"$ref": "#/$defs/opaque_id"},
        "linked_failure_id": {"$ref": "#/$defs/opaque_id"},
        "linked_workaround_id": {"$ref": "#/$defs/opaque_id"},
        "retry_count": {"type": "integer", "minimum": 1, "maximum": 3},
        "failure": {"$ref": "#/$defs/failure"},
        "workaround": {"$ref": "#/$defs/workaround"},
        "recovery_verified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "load_receipt": {
      "type": "object",
      "required": [
        "schema_version", "record_type", "operation_id", "event_id", "scope",
        "session_id", "manifest_digest", "digest_state", "manifest_bytes", "occurred_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "record_type": {"const": "load_receipt"},
        "operation_id": {"$ref": "#/$defs/opaque_id"},
        "event_id": {"$ref": "#/$defs/opaque_id"},
        "scope": {"$ref": "#/$defs/scope"},
        "session_id": {"$ref": "#/$defs/opaque_id"},
        "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "digest_state": {"enum": ["fresh", "reused", "invalidated"]},
        "manifest_bytes": {"type": "integer", "minimum": 1, "maximum": 32000},
        "occurred_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "schema_version", "record_type", "operation_id", "event_id", "scope",
        "state", "head", "source", "evidence", "pr_ref", "approval_head",
        "merged_head", "retry_count", "max_retries", "invalidated_prior_head",
        "failure_checkpoint_id", "occurred_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "record_type": {"const": "release"},
        "operation_id": {"$ref": "#/$defs/opaque_id"},
        "event_id": {"$ref": "#/$defs/opaque_id"},
        "scope": {"$ref": "#/$defs/scope"},
        "state": {"enum": ["working", "committed", "pushed", "pr_open", "checks_pending", "checks_failing", "eligible", "approved", "merged"]},
        "head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "source": {"$ref": "#/$defs/bounded_text"},
        "evidence": {"$ref": "#/$defs/bounded_text_list"},
        "pr_ref": {"type": ["string", "null"], "maxLength": 512},
        "approval_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "merged_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "retry_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 3},
        "invalidated_prior_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "failure_checkpoint_id": {"type": ["string", "null"], "maxLength": 160},
        "occurred_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
